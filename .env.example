# SQL Agent configuration. Copy to .env and fill in. .env is gitignored.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Any OpenAI-compatible endpoint. DeepSeek is the default only because the
# code was written against it. DEEPSEEK_API_KEY is accepted as an alias.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# The database the agent may READ. It is opened read-only:
#   sqlite:///ecommerce.db          -> created with sample data if missing
#   postgresql://user:pass@host/db  -> default_transaction_read_only=on
DATABASE_URL=sqlite:///ecommerce.db

# Rows per query, and prior turns shown to the model.
MAX_ROWS=100
HISTORY_TURNS=3

# Where thumbs-up/down feedback is appended. Empty disables it.
FEEDBACK_PATH=evaluations.csv
